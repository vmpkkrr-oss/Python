def forca_visual(sessao):
    palavra = sessao["palavra"]
    letras = sessao["letras"]
    exibicao = " ".join(c if c in letras else "_" for c in palavra)
    erradas = ", ".join(sorted(c for c in letras if c not in palavra)) or "nenhuma"
    return f"`{exibicao}`\n❌ Erros: **{sessao['erros']}/7** | Letras erradas: {erradas}"


