    s = sessao_atual(ctx, "akinator")
    if not s:
        await ctx.send("Não existe jogo de Akinator ativo. Use `$akinator`!")
        return
    r = normalizar(resposta).replace(" ", "")
    if r in ("parar", "sair", "cancelar"):
        sessoes.pop(chave_sessao(ctx), None)
        await ctx.send("Jogo encerrado! 👋")
        return
    traducoes = {"sim": "sim", "s": "sim", "nao": "nao", "n": "nao", "talvez": "talvez", "t": "talvez", "naosei": "naosei", "?": "naosei"}
    r = traducoes.get(r)
    if r is None:
        await ctx.send("Responda com `$ak sim`, `$ak nao`, `$ak talvez`, `$ak naosei` ou `$ak parar`.")
        return

    if s["fase"] == "palpite":
        if r == "sim":
            ganho = dar_pontos(ctx.author, 12)
            sessoes.pop(chave_sessao(ctx), None)
            await ctx.send(f"🎉 **Acertei!** Você ganhou **{ganho} pontos**. Jogue de novo com `$akinator`!")
            return
        if r != "nao":
            await ctx.send("Meu palpite estava certo? Use `$ak sim` ou `$ak nao`.")
            return
        classificados = ranking_akinator(s["respostas"])
        proximo = next((nome for nome, _ in classificados if nome not in s["tentativas"]), None)
        if proximo is None or len(s["tentativas"]) >= 4:
            sessoes.pop(chave_sessao(ctx), None)
            await ctx.send("😅 Não consegui adivinhar desta vez. Meu banco tem personagens limitados. Tente outro!")
            return
        s["tentativas"].append(proximo)
        await ctx.send(f"🤔 Será que é **{proximo}**? Responda `$ak sim` ou `$ak nao`.")
        return

    s["respostas"][s["pergunta"]] = r
    if len(s["respostas"]) >= 10:
        proximo = ranking_akinator(s["respostas"])[0][0]
        s["fase"] = "palpite"
        s["tentativas"] = [proximo]
        await ctx.send(f"🔮 **Acho que seu personagem é {proximo}!** Acertei? `$ak sim` ou `$ak nao`.")
        return
    s["pergunta"] = proxima_pergunta(s["respostas"])
    if not s["pergunta"]:
        proximo = ranking_akinator(s["respostas"])[0][0]
        s["fase"] = "palpite"
        s["tentativas"] = [proximo]
        await ctx.send(f"🔮 **Seu personagem é {proximo}?** `$ak sim` ou `$ak nao`.")
        return
    await ctx.send(f"🧠 **Pergunta {len(s['respostas']) + 1}/10:** {PERGUNTAS[s['pergunta']]}")


