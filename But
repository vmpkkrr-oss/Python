def resposta_basica(texto, usuario):
    """Modo de conversa simples por regras: funciona mesmo sem chave de IA."""
    t = normalizar(texto)
    if any(p in t for p in ("oi", "ola", "bom dia", "boa noite", "boa tarde", "eae")):
        return f"Oi, {usuario.display_name}! 😄 Quer conversar sobre jogos, Python ou o meio ambiente?"
    if "seu nome" in t or "quem e voce" in t:
        return "Eu sou o EcoDesafio Plus! Sou um bot de jogos, dicas e desafios ecológicos. 🤖"
    if "como voce esta" in t or "tudo bem" in t:
        return "Tudo tranquilo por aqui! E você, como está?"
    if "obrigad" in t or "valeu" in t:
        return "De nada! Se quiser, pode pedir outra dica ou jogar comigo. 😄"
    if "jogo" in t or "brincar" in t or "divers" in t:
        return "Bora! Temos `$akinator`, `$quiz`, `$forca`, `$numero` e `$jokenpo pedra`."
    if "recicl" in t or "lixo" in t:
        return "Reciclar é importante! Use `$reciclar plastico`, `$reciclar papel` ou `$reciclar vidro`."
    if "agua" in t or "meio ambiente" in t or "natureza" in t:
        return random.choice(DICAS) + " 🌱 Use `$desafio` para fazer uma missão!"
    if "python" in t or "program" in t or "codigo" in t:
        return "Python é a linguagem deste bot! Com `discord.py`, a gente cria comandos usando `@bot.command()`."
    if "ajuda" in t or "comando" in t:
        return "Use `$ajuda` para ver tudo que eu faço. Pode me pedir uma dica, jogar ou tirar dúvidas simples!"
    if "piada" in t:
        return random.choice(PIADAS)
    return (
        "Ainda não sei responder isso muito bem no modo básico 😅. "
        "Posso conversar sobre jogos, Python e meio ambiente. "
        "Para respostas mais inteligentes, ative a opção Gemini no computador."
    )


def pedir_gemini(historico):
    """Executado em thread; nao bloqueia os outros comandos do bot."""
    url = f"https://generativelanguage.googleapis.com/v1beta/models/{GEMINI_MODEL}:generateContent"
    corpo = {
        "systemInstruction": {
            "parts": [{"text": (
                "Você é EcoDesafio, um bot simpático de Discord em português do Brasil, "
                "feito para estudantes. Responda de forma clara, amigável, útil e breve. "
                "Ajude com dúvidas escolares, programação, jogos e sustentabilidade. "
                "Não finja realizar ações fora do chat. Nunca peça senhas ou tokens. "
                "Se perguntarem comandos, diga para usar $ajuda. "
                "Não mande @everyone nem marque cargos ou usuários."
            )}]
        },
        "contents": historico,
        "generationConfig": {"maxOutputTokens": 400, "temperature": 0.7},
    }
    requisicao = urllib.request.Request(
        url,
        data=json.dumps(corpo).encode("utf-8"),
        headers={"Content-Type": "application/json", "x-goog-api-key": GEMINI_API_KEY},
        method="POST",
    )
    with urllib.request.urlopen(requisicao, timeout=15) as retorno:
        resposta = json.load(retorno)
    partes = resposta.get("candidates", [{}])[0].get("content", {}).get("parts", [])
    texto = "\n".join(p.get("text", "") for p in partes if p.get("text"))
    if not texto:
        raise ValueError("A API não retornou texto")
    return texto[:1700]


