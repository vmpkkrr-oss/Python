@bot.command()
async def letra(ctx, letra_escolhida: str = ""):
    s = sessao_atual(ctx, "forca")
    if not s:
        await ctx.send("Nenhuma forca ativa. Use `$forca`!")
        return
    letra_normal = normalizar(letra_escolhida).upper()
    if len(letra_normal) != 1 or letra_normal not in "ABCDEFGHIJKLMNOPQRSTUVWXYZ":
        await ctx.send("Digite apenas uma letra. Exemplo: `$letra a`.")
        return
    if letra_normal in s["letras"]:
        await ctx.send("Você já tentou essa letra!\n" + forca_visual(s))
        return
    s["letras"].add(letra_normal)
    if letra_normal not in s["palavra"]:
        s["erros"] += 1
    if set(s["palavra"]).issubset(s["letras"]):
        sessoes.pop(chave_sessao(ctx), None)
        ganho = dar_pontos(ctx.author, 8)
        await ctx.send(f"🎉 Palavra: **{s['palavra']}**! Você ganhou **{ganho} pontos**.")
    elif s["erros"] >= 7:
        sessoes.pop(chave_sessao(ctx), None)
        await ctx.send(f"💀 Acabaram suas chances. A palavra era **{s['palavra']}**.")
    else:
        await ctx.send("🪢 " + forca_visual(s))


