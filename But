def ranking_akinator(respostas):
    """Pontuacao probabilistica pequena, sem modelo de IA ou dependencia externa."""
    pesos = []
    for nome, tags in PERSONAGENS.items():
        log_p = 0.0
        for atributo, valor in respostas.items():
            if valor == "naosei":
                continue
            possui = atributo in tags
            if valor == "talvez":
                log_p += math.log(0.57 if possui else 0.43)
            else:
                combina = possui == (valor == "sim")
                log_p += math.log(0.88 if combina else 0.12)
        pesos.append((nome, log_p))
    maior = max(log_p for _, log_p in pesos)
    normalizados = [(nome, math.exp(log_p - maior)) for nome, log_p in pesos]
    soma = sum(peso for _, peso in normalizados)
    return sorted(((nome, peso / soma) for nome, peso in normalizados), key=lambda x: -x[1])


def proxima_pergunta(respostas):
    ranqueados = ranking_akinator(respostas)
    candidatas = []
    for atributo in PERGUNTAS:
        if atributo in respostas:
            continue
        prob = sum(peso for nome, peso in ranqueados if atributo in PERSONAGENS[nome])
        # Perguntas que dividem as possibilidades proximo de 50/50 ajudam mais.
        candidatas.append((prob * (1 - prob), atributo))
    return max(candidatas)[1] if candidatas else None


