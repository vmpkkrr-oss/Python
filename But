@bot.command()
@commands.cooldown(1, 5, commands.BucketType.user)
async def conversar(ctx, *, mensagem: str):
    mensagem = mensagem.strip()
    if not mensagem or len(mensagem) > 600:
        await ctx.send("Escreva uma mensagem de até 600 caracteres. Exemplo: `$conversar Oi, tudo bem?`")
        return
    if not GEMINI_API_KEY:
        await ctx.send("🤖 " + resposta_basica(mensagem, ctx.author))
        return
    limpar_sessoes()
    chave = chave_sessao(ctx)
    if len(conversas) >= LIMITE_CONVERSAS and chave not in conversas:
        await ctx.send("Muitas conversas ao mesmo tempo. Tente de novo mais tarde.")
        return
    anterior = conversas.get(chave, {}).get("mensagens", [])[-6:]
    atual = anterior + [{"role": "user", "parts": [{"text": mensagem}]}]
    async with limite_ia:
        try:
            async with ctx.typing():
                resultado = await asyncio.to_thread(pedir_gemini, atual)
        except (urllib.error.URLError, TimeoutError, ValueError, IndexError, KeyError) as e:
            print(f"Falha da IA: {type(e).__name__}")
            await ctx.send("⚠️ IA online indisponível. Modo básico: " + resposta_basica(mensagem, ctx.author))
            return
    conversas[chave] = {
        "atualizada": time.monotonic(),
        "mensagens": (atual + [{"role": "model", "parts": [{"text": resultado}]}])[-6:],
    }
    await ctx.send("🤖 " + discord.utils.escape_mentions(resultado))


