def salvar():
    """Salvamento atomico: preserva os dados anteriores, mesmo apos queda."""
    temporario = ARQUIVO.with_suffix(".json.tmp")
    try:
        with temporario.open("w", encoding="utf-8") as f:
            json.dump(jogadores, f, ensure_ascii=False, indent=2)
        os.replace(temporario, ARQUIVO)
    except OSError as e:
        print(f"Erro ao salvar pontuacao: {e}")


def obter_jogador(usuario):
    chave = str(usuario.id)
    dados = jogadores.get(chave)
    if not isinstance(dados, dict):
        dados = {}
        jogadores[chave] = dados
    dados.setdefault("pontos", 0)
    dados.setdefault("desafio", None)
    dados.setdefault("ultimo_dia", None)
    dados.setdefault("dia_jogos", None)
    dados.setdefault("pontos_jogos_hoje", 0)
    dados.setdefault("vitorias", 0)
    dados["nome"] = usuario.display_name
    return dados


def dar_pontos(usuario, valor):
    """Credita pontos em jogos, com teto por dia; retorna quanto ganhou."""
    dados = obter_jogador(usuario)
    hoje = date.today().isoformat()
    if dados["dia_jogos"] != hoje:
        dados["dia_jogos"] = hoje
        dados["pontos_jogos_hoje"] = 0
    restante = max(0, LIMITE_PONTOS_JOGOS - dados["pontos_jogos_hoje"])
    ganho = min(valor, restante)
    dados["pontos_jogos_hoje"] += ganho
    dados["pontos"] += ganho
    dados["vitorias"] += 1
    salvar()
    return ganho


def chave_sessao(ctx):
    return (ctx.guild.id if ctx.guild else 0, ctx.author.id)


def limpar_sessoes():
    agora = time.monotonic()
    for chave, sessao in list(sessoes.items()):
        if agora - sessao.get("atualizada", agora) > SESSAO_SEGUNDOS:
            sessoes.pop(chave, None)
    for chave, registro in list(conversas.items()):
        if agora - registro.get("atualizada", agora) > 30 * 60:
            conversas.pop(chave, None)


def sessao_atual(ctx, tipo=None):
    limpar_sessoes()
    s = sessoes.get(chave_sessao(ctx))
    if s and (tipo is None or s["tipo"] == tipo):
        s["atualizada"] = time.monotonic()
        return s
    return None


def criar_sessao(ctx, dados):
    limpar_sessoes()
    chave = chave_sessao(ctx)
    if len(sessoes) >= MAX_SESSOES and chave not in sessoes:
        return False
    dados["atualizada"] = time.monotonic()
    sessoes[chave] = dados
    return True


def normalizar(texto):
    texto = unicodedata.normalize("NFKD", texto.lower().strip())
    return "".join(c for c in texto if not unicodedata.combining(c))


