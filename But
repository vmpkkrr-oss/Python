@bot.event
async def on_command_error(ctx, error):
    if isinstance(error, commands.CommandOnCooldown):
        await ctx.send(f"⏳ Espere {error.retry_after:.1f}s para usar este comando novamente.")
    elif isinstance(error, commands.CommandNotFound):
        await ctx.send("❓ Comando não encontrado. Digite `$ajuda`.")
    elif isinstance(error, commands.MissingRequiredArgument):
        await ctx.send("Faltou alguma informação. Exemplo: `$conversar oi` ou `$jokenpo pedra`.")
    elif isinstance(error, (commands.BadArgument, commands.TooManyArguments)):
        await ctx.send("Esse valor não parece válido. Use `$ajuda` para conferir.")
    else:
        print(f"Falha de comando: {type(error).__name__}: {error}")
        await ctx.send("⚠️ Ocorreu um erro. Tente novamente daqui a pouco.")


